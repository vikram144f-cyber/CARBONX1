# CARBONX — Story 01.1 local environment
# Copy this file to .env.local and replace every placeholder with a real value.

DATABASE_URL=postgresql://carbonx:password@localhost:5432/carbonx
NEXTAUTH_SECRET=replace-with-at-least-32-characters
NASA_FIRMS_MAP_KEY=replace-with-your-nasa-firms-map-key
FIRMS_POINT_BUFFER_KM=1
MONITORING_INTERVAL_HOURS=6
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
