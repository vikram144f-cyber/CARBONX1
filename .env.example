# CARBONX local environment
# Copy this file to .env.local. Only the core values are needed to boot the app.
# Optional external integrations fail closed and remain unavailable until configured.

DATABASE_URL=postgresql://carbonx:carbonx@localhost:5432/carbonx
NEXTAUTH_SECRET=change-this-local-secret-to-at-least-32-characters
# NASA_FIRMS_MAP_KEY=your-32-character-nasa-firms-map-key
FIRMS_POINT_BUFFER_KM=1
MONITORING_INTERVAL_HOURS=6
# BLOCKCHAIN_CONTRACT_ADDRESS=0xyour-40-hex-character-contract-address
# BLOCKCHAIN_RPC_URL=https://your-sepolia-rpc.example
# BLOCKCHAIN_PRIVATE_KEY=0xyour-64-hex-character-private-key
# GEMINI_API_KEY=your-gemini-api-key
# NVIDIA_API_KEY=your-nvidia-api-key
# ADMIN_REFRESH_TOKEN=local-admin-token
